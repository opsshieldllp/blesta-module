<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([[
    'name' => $this->_('CpguardReseller.add_account', true),
    'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $module->id . '/']
]]);
$this->Widget->create($this->_('CpguardReseller.accounts', true));
?>
<link rel="stylesheet" href="<?php echo $this->Html->safe($this->base_uri . '../components/modules/cpguard_reseller/views/default/css/module.css'); ?>">
<div class="cpguard-module">
<?php if (empty($module->rows)) { ?>
<p class="pad"><?php $this->_('CpguardReseller.no_accounts'); ?></p>
<?php } else { ?>
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr>
        <?php foreach (['account_name', 'balance', 'due', 'services', 'options'] as $heading) { ?>
        <th<?php if (in_array($heading, ['balance', 'due'], true)) { echo ' class="cpguard-amount"'; } ?>><?php $this->_('CpguardReseller.' . $heading); ?></th>
        <?php } ?>
    </tr></thead>
    <tbody>
    <?php foreach ($module->rows as $row) { $balance = $balances[$row->id] ?? []; ?>
    <tr>
        <td><?php echo $this->Html->safe($row->meta->account_name); ?></td>
        <?php if (isset($balance['connection_error'])) { ?>
        <td colspan="3"><span class="text-danger"><?php echo $this->Html->safe($balance['connection_error']); ?></span></td>
        <?php } else { ?>
        <?php foreach (['credit', 'due'] as $kind) { ?>
        <td class="cpguard-amount"><?php foreach (($balance[$kind] ?? []) as $currency => $amount) { ?>
            <div><?php echo $this->Html->safe($amount . ' ' . $currency); ?></div>
        <?php } ?></td>
        <?php } ?>
        <td><?php foreach (($balance['services'] ?? []) as $status => $count) { ?>
            <div><?php echo $this->Html->safe($status . ': ' . $count); ?></div>
        <?php } ?></td>
        <?php } ?>
        <td>
            <div class="cpguard-actions">
            <a class="btn btn-default btn-sm" href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . $module->id . '/' . $row->id . '/'); ?>"><?php $this->_('CpguardReseller.edit'); ?></a>
            <?php
            $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'disable-on-submit',
                'onsubmit' => 'return confirm(' . json_encode($this->_('CpguardReseller.delete_confirm', true)) . ');']);
            $this->Form->fieldHidden('id', $module->id);
            $this->Form->fieldHidden('row_id', $row->id);
            $this->Form->fieldSubmit('delete', $this->_('CpguardReseller.delete', true), ['class' => 'btn btn-danger btn-sm']);
            $this->Form->end();
            ?>
            </div>
        </td>
    </tr>
    <?php } ?>
    </tbody>
</table>
</div>
<?php } ?>
</div>
<?php $this->Widget->end(); ?>
